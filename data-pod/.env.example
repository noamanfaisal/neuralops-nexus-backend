# The data pod's three secrets — copy to .env and fill in.
# The bearer token NeuralOps uses to reach the pod (goes in the MCP server
# dialog's client_secret). Make it long and random:
DATAPOD_TOKEN=
# MinIO credentials (S3_KEY may stay minioadmin; the SECRET must be strong):
S3_KEY=minioadmin
S3_SECRET=
# The OUTSIDE address of MinIO's port 9000, for presigned upload/download
# links (empty = those links are off; queries still work):
#   e.g. https://<runpod-id>-9000.proxy.runpod.net  or  http://<box-ip>:9000
S3_PUBLIC_ENDPOINT=
