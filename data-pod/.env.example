# The data pod's secrets — easiest: `python make_env.py` writes .env with
# strong random values (never printed). By hand: copy to .env and fill in.
# The bearer token NeuralOps uses to reach the pod (goes in the MCP server
# dialog's secret). Make it long and random:
DATAPOD_TOKEN=
# S3 storage credentials (SeaweedFS):
S3_KEY=datapod-admin
S3_SECRET=
# The OUTSIDE address of the S3 port, for presigned upload/download links
# (empty = those links are off; queries still work):
#   e.g. https://<runpod-id>-9000.proxy.runpod.net  or  http://<box-ip>:9000
S3_PUBLIC_ENDPOINT=
# On the NeuralOps box keep the ports on loopback:
# DATAPOD_PORT=127.0.0.1:8900
# MINIO_PORT=127.0.0.1:9000
